# Switchboard production environment. Every variable without a default is required; the app
# refuses to boot and lists what's missing. See the README ("Configuration").

SWITCHBOARD_TAG=
POSTGRES_PASSWORD=
TRUSTED_PROXIES=
RELEASES_NETWORK=

# Phoenix
SECRET_KEY_BASE=
PHX_HOST=switchboard.example.com
# PUBLIC_URL=https://switchboard.example.com

# openssl rand -base64 32
CLOAK_KEY=
# CLOAK_RETIRED_KEYS=

# Forgejo OAuth2 app (confidential), redirect URI https://$PHX_HOST/auth/forgejo/callback
FORGEJO_URL=https://git.example.com
FORGEJO_CLIENT_ID=
FORGEJO_CLIENT_SECRET=
# Set at least one membership allowlist.
ALLOWED_FORGEJO_ORGS=acme
# ALLOWED_FORGEJO_TEAMS=acme/developers
ADMIN_USERNAMES=ana

# Upstreams
PLANE_URL=https://plane.example.com
PLANE_WORKSPACE=acme
ARGUS_URL=https://argus.example.com
OUTLINE_URL=https://outline.example.com
ROCKETCHAT_URL=https://chat.example.com
# An existing bot user's personal access token, for notify_me and watch notices (DMs to the
# caller or the watch owner only).
ROCKETCHAT_BOT_USER_ID=
ROCKETCHAT_BOT_TOKEN=
RELEASES_URL=http://releases:8080
RELEASES_TOKEN=

# Optional
# Secret of the Forgejo webhook for Actions runs (POST /hooks/forgejo). Without it the endpoint
# refuses every request and watches poll Forgejo instead.
# FORGEJO_WEBHOOK_SECRET=
# Rocket.Chat REST calls a minute per route with people's tokens (default 8); keep it below the
# Rocket.Chat server's per-route limit.
# ROCKETCHAT_ROUTE_BUDGET=8
# GitHub (optional): an OAuth App with callback https://$PHX_HOST/auth/github/callback, and the
# owners (orgs or users) whose repositories live on GitHub. See the README.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OWNERS=example-org
# GitHub Enterprise Server only (the API is <url>/api/v3):
# GITHUB_ENTERPRISE_URL=https://github.example
# ADMIN_NETWORKS=100.64.0.0/10,fd7a:115c:a1e0::/48
# HEALTH_NETWORKS=
# AUDIT_RETENTION_DAYS=180
# POOL_SIZE=10
